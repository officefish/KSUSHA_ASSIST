{
  "name": "@kubiki/server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер Kubiki: NestJS 11 на Fastify, pino, zod",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node ./dist/main.js",
    "clean": "rimraf dist .turbo .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@kubiki/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "dotenv": "^16.4.5",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
